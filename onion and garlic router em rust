    let mut network = GarlicRouterNetwork::new();
    
    // Cria routers em países fronteiriços
    let border_routers = vec![
        ("router-br-py", "BR-PY"),
        ("router-py-ar", "PY-AR"),
        ("router-ar-cl", "AR-CL"),
        ("router-cl-pe", "CL-PE"),
        ("router-pe-bo", "PE-BO"),
        ("router-bo-br", "BO-BR"),
        ("router-uy-ar", "UY-AR"),
        ("router-ar-uy", "AR-UY"),
    ];
    
    for (id, country) in border_routers {
        let router = OnionRouter::new(id.to_string(), country.to_string());
        network.add_router(router);
    }
    
    // Cria canal para processamento em lote
    let (tx, rx) = bounded::<GarlicMessage>(100);
    
    // Inicia workers paralelos
    for i in 0..4 {
        let worker_rx = rx.clone();
        let worker = MessageWorker::new(i, worker_rx);
        worker.start();
    }
    
    // Inicia processamento nos routers
    for router in network.routers.values() {
        let tx_clone = tx.clone();
        let router_clone = Arc::clone(router);
        
        thread::spawn(move || {
            router_clone.start_processing(tx_clone);
        });
    }
    
    // Cria circuito e envia mensagens
    match network.create_circuit("CL") {
        Ok(circuit_id) => {
            println!("Circuit created: {}", circuit_id);
            
            // Simula envio de 450 mensagens (3 batches de 150)
            for i in 0..450 {
                let message = format!("Message {} - Test data", i);
                
                if let Err(e) = network.send_message(circuit_id, message.as_bytes()) {
                    eprintln!("Failed to send message {}: {}", i, e);
                }
                
                if i % 50 == 0 {
                    println!("Sent {} messages", i);
                }
                
                thread::sleep(Duration::from_micros(10));
            }
        }
        Err(e) => eprintln!("Failed to create circuit: {}", e),
    }
    
    thread::sleep(Duration::from_secs(5));
    println!("Simulation complete");
}