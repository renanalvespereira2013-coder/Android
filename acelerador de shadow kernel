#[cfg(test)]
mod tests {
    use super::*;
    
    #[test]
    fn test_chacha20_encryption() {
        let key = generate_key();
        let nonce = generate_nonce();
        let mut cipher = FastChaCha20::new(&key, &nonce);
        
        let mut data = b"Hello, World! This is a secret message.".to_vec();
        let original = data.clone();
        
        cipher.apply_keystream(&mut data);
        assert_ne!(data, original);
        
        // Decrypt
        let mut decipher = FastChaCha20::new(&key, &nonce);
        decipher.apply_keystream(&mut data);
        assert_eq!(data, original);
    }
    
    #[tokio::test]
    async fn test_onion_routing() {
        // Cria rota com 3 hops
        let layers = vec![
            OnionLayer {
                key: generate_key(),
                nonce: generate_nonce(),
                next_hop: Some("node1.onion".to_string()),
            },
            OnionLayer {
                key: generate_key(),
                nonce: generate_nonce(),
                next_hop: Some("node2.onion".to_string()),
            },
            OnionLayer {
                key: generate_key(),
                nonce: generate_nonce(),
                next_hop: Some("destination.onion".to_string()),
            },
        ];
        
        let payload = b"Secret payload".to_vec();
        let mut packet = OnionPacket::new(payload.clone(), layers.clone());
        
        // Encapsula
        packet.wrap();
        
        // Desencapsula camada por camada
        for layer in layers.iter() {
            let next_hop = packet.unwrap_layer(&layer.key, &layer.nonce);
            assert!(next_hop.is_some());
        }
        
        assert_eq!(packet.data, payload);
    }
    
    #[tokio::test]
    async fn test_garlic_routing() {
        let router = GarlicRouter::new(10);
        
        // Cria múltiplos pacotes
        let mut packets = vec![];
        for i in 0..5 {
            let layer = OnionLayer {
                key: generate_key(),
                nonce: generate_nonce(),
                next_hop: Some(format!("node{}.onion", i)),
            };
            let packet = OnionPacket::new(
                format!("Payload {}", i).into_bytes(),
                vec![layer],
            );
            packets.push(packet);
        }
        
        // Processa em batch
        let encrypted = router.route_garlic_batch(packets).await;
        assert_eq!(encrypted.len(), 5);
    }
}

